# --- Supabase Auth (Google OAuth) ---------------------------------------------
# From your Supabase project: Settings → API. Public/anon key is safe in the
# browser (guarded by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Prisma (resume sync data layer) ------------------------------------------
# From Supabase: Settings → Database → Connection string.
# DATABASE_URL uses the pooled (PgBouncer, port 6543) connection for the app;
# DIRECT_URL uses the direct (port 5432) connection for `prisma db push`/migrate.
DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-ref:PASSWORD@aws-region.pooler.supabase.com:5432/postgres
